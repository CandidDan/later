// Browser-safe public values only. Never put a service-role or secret key in an iPhone app.
// $() keeps xcconfig from interpreting // in URLs as a comment.
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_PUBLIC_ANON_KEY
LATER_API_BASE_URL = https:/$()/notfor.now
