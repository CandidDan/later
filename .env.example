# Production configuration contract: see README.md. Validate an ignored local copy offline with
# `pnpm launch:check`. The command prints names and capability states, never configured values.
# Server-only Supabase credentials. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Twilio WhatsApp webhook configuration.
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=https://notfor.now/api/inbound/whatsapp
TWILIO_CAPTURE_USER_ID=

# Server-only Anthropic intent analysis. The model identifier is configuration so the
# experiment can compare a Haiku and a Sonnet model without a code change.
ANTHROPIC_API_KEY=
ANTHROPIC_INTENT_MODEL=claude-haiku-4-5
ANTHROPIC_RESOLUTION_MODEL=claude-haiku-4-5
ANTHROPIC_SEGMENT_MODEL=claude-haiku-4-5
# Maximum bytes fetched from an already identified public transcript/text source (max 2 MiB).
SEGMENT_SOURCE_MAX_BYTES=131072

# Shared secret required by POST /api/jobs/process. Leave empty to disable the endpoint.
JOBS_PROCESS_SECRET=

# Server-only WhatsApp media download credentials (never NEXT_PUBLIC_).
TWILIO_ACCOUNT_SID=
# Maximum original media bytes; default 5 MiB, allowed 1..20 MiB.
# Only api.twilio.com account media paths and mms.twiliocdn.com are approved.
# Redirects to the CDN never receive account credentials.
# Unsafe input fails immediately; transient failures retry up to three attempts.
CAPTURE_MEDIA_MAX_BYTES=5242880

# Server-only inbound email (Resend). The webhook secret verifies signatures only; it is not
# an API credential and the public webhook path never holds RESEND_API_KEY.
RESEND_WEBHOOK_SECRET=
# Mail is captured only when a recipient's local part (before any +tag) equals this token.
EMAIL_INBOUND_TOKEN=
EMAIL_CAPTURE_USER_ID=
# Used by the background enrichment job to retrieve the parsed email and its attachments.
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
# Maximum bytes per retrieved email representation or attachment; default 5 MiB, allowed 1..20 MiB.
EMAIL_MAX_BYTES=5242880

# Research console (/research). The public pair may reach the browser; the service-role key
# above must never be exposed with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The only user id allowed to evaluate captures in v0. Leave empty to disable the console.
RESEARCH_USER_ID=
