# Flow store hygiene.
#
# The real guarantee that branches can't clobber task state is behavioural, not a merge
# driver: feature branches never modify .flow/, and flow-gates.yml rejects any PR that
# touches .flow/tasks/. (Custom merge drivers don't run on GitHub's server-side merge, so
# we don't rely on one.) These attributes are just cosmetic / diff hygiene.

# board.html is generated by board-builder from the task files — collapse it in diffs/reviews.
.flow/board.html linguist-generated=true

# Transient board export; should never be committed (see .gitignore), marked here too.
.flow/board-edits.json linguist-generated=true
